<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.gameblazers.sales-backfill</string>
    <key>Disabled</key>
    <true/>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/shyampatel/Desktop/GB/market_py/update.py</string>
        <string>--db</string>
        <string>/Users/shyampatel/Desktop/GB/market_py/gameblazers.db</string>
        <string>--backfill</string>
    </array>
    <key>StartInterval</key>
    <integer>3600</integer>
    <key>WorkingDirectory</key>
    <string>/Users/shyampatel/Desktop/GB</string>
    <key>StandardOutPath</key>
    <string>/Users/shyampatel/Desktop/GB/market_py/logs/sales-backfill.log</string>
    <key>StandardErrorPath</key>
